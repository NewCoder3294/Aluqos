# Aluqos environment template. Copy to `.env` and fill in real values.
# Anything left blank is optional and degrades to a stub or MOCK_MODE.

# ── Supabase ────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com/. URL and anon key are public
# (used in the browser). The service role key is server-only and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UUID for the hardcoded demo user that powers the no-auth preview experience.
# Any UUID works; an `employees` row with this user_id is created by the seed.
SAATHI_DEMO_USER_ID=11111111-1111-1111-1111-111111111111

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── OAuth (third-party integrations) ────────────────────────────────────────
# Random ≥32 chars — used to HMAC-sign OAuth state cookies. Generate with:
#   openssl rand -base64 48
OAUTH_STATE_SECRET=

# Linear (https://linear.app/settings/api/applications)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
#
# One Google OAuth client (Web application) handles both:
#   1. Sign-in via Supabase Auth's Google provider — paste these into
#      Supabase Studio → Authentication → Providers → Google.
#   2. Gmail API token refresh from this app's server — needs them here so
#      src/integrations/gmail/client.ts can hit oauth2.googleapis.com/token.
#
# Authorized redirect URI on the Google client (only one needed):
#   https://<your-supabase-ref>.supabase.co/auth/v1/callback
#
# Authorized JS origins:
#   http://localhost:3000
#   https://<your-supabase-ref>.supabase.co
#
# In Supabase Studio → Authentication → URL Configuration → Redirect URLs, add:
#   http://localhost:3000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
# Public-facing base URL (no trailing slash). Used in OAuth redirects and
# absolute links from server actions.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Inngest (background jobs) ───────────────────────────────────────────────
# https://app.inngest.com — leave blank to no-op event sends.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
